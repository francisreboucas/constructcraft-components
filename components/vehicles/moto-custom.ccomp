65, 0, 0}, n = 6, ref = {0, 0, 1}, closed = false, a0 = 0, a1 = 360}, {k = \"lathe\", prof = {{0, 0}, {0.0072, 0}, {0.0072, 0.0065}, {0, 0.0065}}, o = {0.0745, -0.72122, 0.52579}, a = {-0.0065, 0, 0}, n = 6, ref = {0, 0, 1}, closed = false, a0 = 0, a1 = 360}, {k = \"lathe\", prof = {{0, 0}, {0.0072, 0}, {0.0072, 0.0065}, {0, 0.0065}}, o = {-0.0745, -0.78481, 0.42402}, a = {0.0065, 0, 0}, n = 6, ref = {0, 0, 1}, closed = false, a0 = 0, a1 = 360}, {k = \"lathe\", prof = {{0, 0}, {0.0072, 0}, {0.0072, 0.0065}, {0, 0.0065}}, o = {-0.0745, -0.72122, 0.52579}, a = {0.0065, 0, 0}, n = 6, ref = {0, 0, 1}, closed = false, a0 = 0, a1 = 360}}},\n{nm = \"Cabo da embreagem\", mt = \"Plástico preto\", dt = {\"medium\", \"fine\"}, pl = false, g = \"\", parts = {{k = \"gtube\", pts = {{{0.26475, -0.20603, 1.15527}, \"steer\"}, {{0.22975, -0.23603, 1.10527}, \"steer\"}, {{0.13, -0.44712, 1.12098}, \"steer\"}, {{0.08, -0.50859, 0.9943}, \"steer\"}, {{0.072, -0.55055, 0.90261}, \"steer\"}, {{0.06, -0.60927, 0.78601}, \"steer\"}, {{0.094, -0.448, 0.69}, nil}, {{0.112, -0.443, 0.62}, nil}, {{0.139, -0.452, 0.5}, nil}, {{0.095, -0.488, 0.418}, nil}, {{-0.095, -0.488, 0.418}, nil}, {{-0.16, -0.445, 0.392}, nil}, {{-0.17, -0.33, 0.352}, nil}, {{-0.17, -0.2, 0.318}, nil}, {{-0.16, 0, 0.302}, nil}, {{-0.146, 0.1, 0.306}, nil}, {{-0.134, 0.136, 0.31}, nil}}, r = 0.0038, n = 8, per = 5}}},\n{nm = \"Cabo do acelerador 1\", mt = \"Plástico preto\", dt = {\"medium\", \"fine\"}, pl = false, g = \"\", parts = {{k = \"gtube\", pts = {{{-0.28167, -0.17812, 1.12442}, \"steer\"}, {{-0.26167, -0.20812, 1.05442}, \"steer\"}, {{-0.13, -0.44712, 1.12098}, \"steer\"}, {{-0.08, -0.50859, 0.9943}, \"steer\"}, {{-0.072, -0.55055, 0.90261}, \"steer\"}, {{-0.06, -0.60927, 0.78601}, \"steer\"}, {{-0.08, -0.452, 0.69}, nil}, {{-0.086, -0.4, 0.768}, nil}, {{-0.088, -0.28, 0.752}, nil}, {{-0.097, -0.16, 0.73}, nil}, {{-0.108, -0.08, 0.69}, nil}, {{-0.108, -0.079, 0.629}, nil}}, r = 0.0036, n = 8, per = 5}}},\n{nm = \"Cabo do acelerador 2\", mt = \"Plástico preto\", dt = {\"medium\", \"fine\"}, pl = false, g = \"\", parts = {{k = \"gtube\", pts = {{{-0.29308, -0.17446, 1.12387}, \"steer\"}, {{-0.27308, -0.20446, 1.05387}, \"steer\"}, {{-0.14, -0.44712, 1.12098}, \"steer\"}, {{-0.09, -0.50859, 0.9943}, \"steer\"}, {{-0.082, -0.55055, 0.90261}, \"steer\"}, {{-0.07, -0.60927, 0.78601}, \"steer\"}, {{-0.085, -0.452, 0.69}, nil}, {{-0.096, -0.4, 0.768}, nil}, {{-0.098, -0.28, 0.752}, nil}, {{-0.111, -0.16, 0.73}, nil}, {{-0.124, -0.08, 0.69}, nil}, {{-0.124, -0.079, 0.629}, nil}}, r = 0.0036, n = 8, per = 5}}},\n{nm = \"Fiação do punho esquerdo\", mt = \"Plástico preto\", dt = {\"fine\"}, pl = false, g = \"\", parts = {{k = \"gtube\", pts = {{{0.27131, -0.15015, 1.13894}, \"steer\"}, {{0.215, -0.23076, 1.12088}, \"steer\"}, {{0.13, -0.28642, 1.07559}, \"steer\"}, {{0.052, -0.43069, 1.1284}, \"steer\"}, {{0.035, -0.50647, 1.06373}, \"steer\"}, {{0.015, -0.553, 0.95}, \"steer\"}}, r = 0.004, n = 8, per = 5}}},\n{nm = \"Fiação do punho direito\", mt = \"Plástico preto\", dt = {\"fine\"}, pl = false, g = \"\", parts = {{k = \"gtube\", pts = {{{-0.27131, -0.15015, 1.13894}, \"steer\"}, {{-0.215, -0.23076, 1.12088}, \"steer\"}, {{-0.13, -0.28642, 1.07559}, \"steer\"}, {{-0.052, -0.43069, 1.1284}, \"steer\"}, {{-0.035, -0.50647, 1.06373}, \"steer\"}, {{-0.015, -0.553, 0.95}, \"steer\"}}, r = 0.004, n = 8, per = 5}}},\n{nm = \"Fiação do farol\", mt = \"Plástico preto\", dt = {\"fine\"}, pl = false, g = \"\", parts = {{k = \"gtube\", pts = {{{0, -0.55048, 0.92076}, \"steer\"}, {{0, -0.53548, 0.89576}, \"steer\"}, {{0, -0.54196, 0.85597}, \"steer\"}}, r = 0.0045, n = 8, per = 4}}},\n{nm = \"Fiação do velocímetro\", mt = \"Plástico preto\", dt = {\"fine\"}, pl = false, g = \"\", parts = {{k = \"gtube\", pts = {{{0, -0.38638, 1.06534}, \"steer\"}, {{0, -0.36496, 1.06375}, \"steer\"}, {{0, -0.37291, 1.04159}, \"steer\"}}, r = 0.0035, n = 8, per = 4}}}\n}\n\nlocal function grouped(G, q, g) if g and g ~= \"\" then return G[g].point(q) end; return q end\nfunction K.spring(m, s, G)\n  local a, b = grouped(G, s.a[1], s.a[2]), grouped(G, s.b[1], s.b[2])\n  local ax, e1, e2 = frame(sub(b, a), s.ref)\n  local len = sqrt(dot(sub(b, a), sub(b, a)))\n  local per = s.per_turn or 16\n  local n = math.max(4, floor(s.turns * per))\n  local path = {}\n  for i = 0, n do\n    local t = i / n; local ang = 2 * math.pi * s.turns * t\n    path[i + 1] = add(add(a, mul(ax, len * t)), add(mul(e1, s.r * cos(ang)), mul(e2, s.r * sin(ang))))\n  end\n  K.sweep(m, { path = path, sec = circle2(s.wire, s.n or 8), caps = true })\nend\nfunction K.gtube(m, s, G)\n  local pts = {}\n  for i, q in ipairs(s.pts) do pts[i] = grouped(G, q[1], q[2]) end\n  K.sweep(m, { path = catmull(pts, s.per or 6), sec = circle2(s.r, s.n or 10), caps = true, up = s.up })\nend\n\nfunction geometry(p)\n  local steer = p.AnguloGuidao or 0\n  if steer > STEER_LOCK then steer = STEER_LOCK elseif steer < -STEER_LOCK then steer = -STEER_LOCK end\n  local stand = p.Descanso or 0\n  if stand < 0 then stand = 0 elseif stand > 1 then stand = 1 end\n  local G = { steer = rotation(STEER_O, STEER_D, steer), stand = rotation(STAND_O, STAND_D, (stand - 1) * STAND_SWING) }\n  local out = {}\n  for _, pc in ipairs(PIECES) do\n    local m = { v = {}, f = {}, nv = 0, nf = 0 }\n    for _, s in ipairs(pc.parts) do K[s.k](m, s, G) end\n    if pc.g ~= \"\" then G[pc.g].all(m.v, m.nv) end\n    out[#out + 1] = mesh { vertices = m.v, faces = m.f, name = pc.nm, material = pc.mt, detail = pc.dt, in_plan = pc.pl }\n  end\n  return out\nend\n",
        ),
        material: "Cromado",
        in_plan: false,
      ),
